# Copy this to .env and fill in real values. .env itself is
# git-ignored and should never be committed — this file (.env.example)
# is the one that's safe to check in, since it has no real secrets.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Free key from SAM.gov -> Account Details -> Public API Key.
# Leave blank if you're not running live ingestion right now.
SAM_GOV_API_KEY=

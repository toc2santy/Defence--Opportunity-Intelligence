# Copy this to .env and fill in real values. .env itself is
# git-ignored and should never be committed — this file (.env.example)
# is the one that's safe to check in, since it has no real secrets.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Free key from SAM.gov -> Account Details -> Public API Key.
# Leave blank if you're not running live ingestion right now.
SAM_GOV_API_KEY=

# Outbound email (currently just the Forgot Password link). Leave
# SMTP_HOST blank to run without a real email account — the reset
# link is logged to the API's console instead, which is enough to
# test the flow end-to-end, just not to actually deliver an email.
# Any real SMTP account works: a Gmail address with an App Password
# (not the normal account password), SendGrid, Postmark, your own
# mail server, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@defence-oi.local

# Backup & DR Phase 1 (2026-09, see app/backup.py). Leave all four
# blank to run without backups — the scheduled job logs a clear
# "skipped: not configured" line instead of crashing, same pattern
# as SAM_GOV_API_KEY above.
#
# Cloudflare R2: dashboard -> R2 Object Storage -> create a bucket ->
# "Manage R2 API Tokens" -> Create API Token (Object Read & Write,
# scoped to that one bucket). R2_ACCOUNT_ID is in the dashboard
# sidebar (same account ID for every bucket/token).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=defence-oi-backups

# The passphrase every backup is encrypted with before it ever leaves
# this host — NOT your R2 credentials, a separate secret. Generate
# with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means losing the ability to restore ANY backup ever
# taken with it — store it somewhere durable outside this .env file
# too (a password manager, not just this one machine).
BACKUP_ENCRYPTION_KEY=

# Backup & DR Phase 4 (2026-09) — where a failed backup, a failed
# restore-drill, or total scheduler silence gets emailed. Optional:
# leave blank to have alerts logged to the API's console instead of
# sent (see app/backup.py's _alert()), same dev-mode fallback pattern
# as SMTP_HOST above. This is the PLATFORM OPERATOR's own address,
# not any tenant's — deliberately separate from every tenant email in
# the system.
ALERT_EMAIL=

# MFA (2026-09) — encrypts each user's TOTP secret at rest (app/mfa.py).
# A DEDICATED key, deliberately separate from BACKUP_ENCRYPTION_KEY —
# reusing one secret for two purposes means a leak of either
# compromises both. Generate the same way:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before any user can call /auth/mfa/setup; rotating it
# invalidates every already-enrolled user's stored secret (they would
# need to re-enroll).
MFA_ENCRYPTION_KEY=

# PII encryption at rest (2026-09) — encrypts a tenant's own GST/PAN/
# TAN/IEC registration numbers (app/pii_encryption.py). A DEDICATED
# key, same "separate from every other purpose's key" discipline as
# MFA_ENCRYPTION_KEY/BACKUP_ENCRYPTION_KEY above. Generate the same
# way: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before /company/profile can accept a gst_number/pan_number/
# tan_number/iec_license value; rotating it makes every already-stored
# value undecryptable (the tenant would need to re-enter them).
PII_ENCRYPTION_KEY=

# SSO — "Continue with Google" / "Continue with Microsoft" on the
# login screen (2026-09, see app/oidc.py). Both are optional and
# independent: leave either provider's three vars blank to leave that
# button non-functional (clicking it returns a clear "not configured"
# error) without breaking anything else. This is ADDITIVE to
# email+password login, never a replacement — every account still
# works with a password regardless of whether SSO is set up.
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application.
#   Authorized redirect URI: <API_BASE_URL>/auth/oidc/google/callback
#   (e.g. https://api.yourdomain.com/auth/oidc/google/callback —
#   must be the exact, real, publicly reachable API_BASE_URL below,
#   not localhost, for a real deployment).
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_ISSUER=https://accounts.google.com
#
# Microsoft: entra.microsoft.com (or portal.azure.com) -> App
# registrations -> New registration -> "Accounts in any organizational
# directory and personal Microsoft accounts" -> Redirect URI (Web):
#   <API_BASE_URL>/auth/oidc/microsoft/callback
# Then Certificates & secrets -> New client secret for
# OIDC_MICROSOFT_CLIENT_SECRET.
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0

# This API's own public base URL — required for SSO above (the
# redirect_uri a provider sends a user back to must exactly match what
# you registered with that provider). Leave as localhost for local
# dev; a real deployment must set this to its real public address.
API_BASE_URL=http://localhost:8000

# Production configuration. Copy to /opt/doi/.env.prod (deploy/gen-secrets.sh
# does this and fills every random secret for you), then fill the rest.
# This file is git-ignored on the server; never commit the filled-in copy.
# Use only letters, digits, - and _ in passwords (they go into a URL).

# ---- Where it lives -------------------------------------------------------
# Your domain. The app will be at app.<DOMAIN>, the API at api.<DOMAIN>.
DOMAIN=
# Let's Encrypt registration / expiry notices go here.
ACME_EMAIL=
# no   = browsers talk to this server directly. START HERE for the first
#        deploy, so Caddy can get its Let's Encrypt certificate while the DNS
#        records are still "DNS only".
# yes  = Cloudflare proxy ("orange cloud") is in front: free DDoS/WAF, the
#        origin refuses anyone who is not Cloudflare, real visitor IPs come
#        from CF-Connecting-IP. Switch to this in DEPLOY.md step 8 (then
#        re-run deploy/deploy.sh). Recommended for the long term.
USE_CLOUDFLARE=no

# ---- Who may create an account (REQUIRED) ----------------------------------
# Comma-separated exact emails and/or @domains. Existing accounts are never
# affected. Use * only if you really want open sign-up.
#   SIGNUP_ALLOWLIST=you@yourcompany.com,@alpha-elsec.com
SIGNUP_ALLOWLIST=

# ---- Secrets (filled by deploy/gen-secrets.sh — keep a copy OFF this server) ----
JWT_SECRET=
POSTGRES_PASSWORD=
DOI_APP_PASSWORD=
# If you restore the dev database here, set these two to the DEV values first.
MFA_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
# Encrypts every backup before it leaves the server. Lose it and no backup
# can ever be restored.
BACKUP_ENCRYPTION_KEY=

# ---- Backups: a PROD-ONLY Cloudflare R2 bucket (REQUIRED) -------------------
# Do NOT reuse the dev bucket: dev and prod would overwrite and prune each
# other's backups. Create a new bucket + a token scoped to that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=

# ---- Email (REQUIRED: sign-up verification and password reset are sent by it) ----
# Any SMTP provider works (Brevo, Resend, Amazon SES, Zoho, ...). Use a sending
# address on YOUR domain and add the provider's SPF/DKIM DNS records, or mail
# lands in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where backup-failed / restore-drill-failed / scheduler-silent alerts go.
ALERT_EMAIL=

# ---- Data sources / SSO (optional) ------------------------------------------
SAM_GOV_API_KEY=
# After the domain is live, add  https://api.<DOMAIN>/auth/oidc/google/callback
# (and .../microsoft/callback) as an authorised redirect URI in each console.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
